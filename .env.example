# Salin jadi .env (jangan di-commit). Wajib diisi:
# Bikin yang panjang & acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Opsional
PORT=3000
# 127.0.0.1 = cuma bisa diakses dari mesin itu sendiri (aman, taruh reverse proxy/HTTPS di depannya).
# Di Docker / PaaS biasanya harus 0.0.0.0.
HOST=127.0.0.1
# Hostname publik yang boleh, pisah koma (mis. mcp.contoh.com). Kosong = nggak dicek.
ALLOWED_HOSTS=
